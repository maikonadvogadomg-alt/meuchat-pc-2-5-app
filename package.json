{
  "name": "meuchat-pc",
  "version": "1.0.0",
  "description": "Meu Chat para PC — o chat numa janela própria, com a mesa do lado (playground, links, códigos), a voz Francisco grátis e o Ollama",
  "author": "Maikon",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "programa": "electron .",
    "exe": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "msedge-tts": ">=1.3.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.maikon.meuchat.pc.nchatnovo",
    "productName": "Meu Chat (Chat novo)",
    "executableName": "MeuChat-nchatnovo",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Meu Chat (Chat novo)",
      "artifactName": "MeuChat-nchatnovo-Instalar.exe",
      "include": "electron/instalar.nsh"
    },
    "portable": {
      "artifactName": "MeuChat-nchatnovo-sem-instalar.exe"
    }
  },
  "portaDoPrograma": 9510
}
